# PT's Tactical Foreman — environment variables
# Copy to .env.local and fill in. Never commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase (database + auth + storage) ---
# From your Supabase project settings. For local dev, `supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# File storage (Task 26): photos, receipts, permits, plans.
# Create a bucket named `project-files` in Supabase Storage and leave it
# PRIVATE (uncheck "Public bucket"). Reads go through short-lived signed URLs
# minted server-side with the service-role key above — the bytes are never
# publicly addressable. Uploads stay disabled until both exist.

# Direct Postgres connection for Drizzle migrations (server-only).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- AI (Anthropic Claude) ---
ANTHROPIC_API_KEY=your-anthropic-key
# Default model tiers (override per org in settings; see docs/tech-stack.md).
AI_MODEL_DEFAULT=claude-opus-4-8
AI_MODEL_FAST=claude-haiku-4-5

# --- Transactional email (Resend) ---
RESEND_API_KEY=your-resend-key
EMAIL_FROM=no-reply@example.com

# --- Google Workspace (Gmail + Calendar OAuth) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# --- Monitoring (optional in dev) ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
